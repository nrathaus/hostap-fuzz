# Generated by axes/run_profiles.sh: one hostapd config and one ledger per
# axis setting. Reproducible from the tree, so not worth carrying.
fuzz-profiles/
__pycache__/

# Run artefacts. fuzzing/topology/ writes these outside the checkout -- see
# FUZZ_LOGDIR, which defaults to $TMPDIR/hostap-fuzz -- so nothing here should
# ever appear. These patterns are a backstop for a run started by hand with
# the older paths, not the mechanism.
fuzz-*.log
fuzz-ledger-*.json
fuzz-repro/
